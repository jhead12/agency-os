# ── agency-os environment variables ────────────────────────────────
# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real credentials.
#
#   cp .env.example .env
#
# Then load them before running:
#   source .env && python3 agency_os.py sync --campaign voter-guide--cbo-outreach-los-angeles

# ── Email sending channels ──────────────────────────────────────────

# Smartlead (cold email sequencing + warmup)
# https://app.smartlead.ai → Settings → API Keys
SMARTLEAD_API_KEY=

# OR — direct SMTP (Gmail, SendGrid, Postmark, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Contact enrichment ──────────────────────────────────────────────

# Apollo.io (contact finder — names, emails, titles at orgs)
# https://app.apollo.io → Settings → API Keys
APOLLO_API_KEY=

# Hunter.io (email finder + verifier by domain)
# https://hunter.io → API → API Key
HUNTER_API_KEY=

# ── u9itus Portal Integration ───────────────────────────────────────

# Base URL of the u9itus instance (the Laravel app)
U9ITUS_BASE_URL=https://www.u9itus.com

# Bearer token for the agency API (POST /api/v1/agency/demo-portals, GET /events)
# Generate a token, store its SHA-256 hash in u9itus env as AGENCY_OS_TOKEN_HASH
U9ITUS_AGENCY_TOKEN=

# ── Direct Mail (Lob) ────────────────────────────────────────────────

# Lob API key — https://dashboard.lob.com/register (Developer plan is free)
LOB_API_KEY=

# Return address printed on all mail pieces
LOB_FROM_NAME=Joshua
LOB_FROM_ADDRESS_LINE1=
LOB_FROM_ADDRESS_CITY=
LOB_FROM_ADDRESS_STATE=CA
LOB_FROM_ADDRESS_ZIP=

# ── SMS ─────────────────────────────────────────────────────────────

# Twilio (sms_twilio channel) — https://console.twilio.com → Account Info
# Set FROM_NUMBER (E.164, e.g. +13105550123) OR a Messaging Service SID.
# US business texting requires A2P 10DLC registration in Twilio first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

# ── Scheduling ──────────────────────────────────────────────────────

# Calendly (calendly scheduler)
# Event type link used for {{booking_link}} in templates
CALENDLY_SCHEDULING_URL=
# Personal access token for `agency_os.py bookings` sync
# https://calendly.com → Integrations → API & Webhooks
CALENDLY_API_TOKEN=

# ── Lead packages (x402 payments) ───────────────────────────────────
# Off unless set to "on". Needs: pip install -r requirements-payments.txt
# AGENCY_OS_X402=on
# Mainnet (real money) also needs this; base-sepolia (test USDC) does not.
# AGENCY_OS_X402_ALLOW_MAINNET=1
# Approved package providers, comma-separated (https, or http://localhost for dev)
# AGENCY_OS_LEAD_PROVIDERS=https://leads.example.com
# Coinbase CDP server wallet that pays (https://portal.cdp.coinbase.com)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# AGENCY_OS_CDP_ACCOUNT=agency-os
# Optional AI review of package leads' call notes (pip install anthropic)
# AGENCY_OS_AI_REVIEW=on
# ANTHROPIC_API_KEY=

# ── Web dashboard / deployment ──────────────────────────────────────

# First owner account for the web dashboard. Used only when the database has
# no users yet (e.g. first Railway boot); ignored afterwards. Change the
# password from /account after signing in. Locally you can instead run:
#   python agency_os.py users create-owner --email you@example.com
AGENCY_OS_OWNER_EMAIL=
AGENCY_OS_OWNER_PASSWORD=
# AGENCY_OS_OWNER_NAME=

# Public URL of the dashboard, used in welcome-email links
# (`agency_os.py users invite`). Defaults to Railway's public domain.
# AGENCY_OS_BASE_URL=https://agency-os.up.railway.app

# PostgreSQL connection URL. On Railway, reference the Postgres service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://localhost/agency_os

# Optional: where campaign files from the database are written to be loaded
# (a local cache; defaults to a temp dir).
# AGENCY_OS_CAMPAIGNS_DIR=

BASE_URL = "https://www.u9itus.com"  # ← change this

# File: ~/projects/agency-os/campaigns/voter-guide-cbo/campaign.yaml
# Bottom of the file:
sender_name= "Joshua"        # ← change this
sender_email= "joshua@u9itus.com"  # ← change this


# Agency Access
AGENCY_OS_PASSWORD= "test"
AGENCY_OS_OWNER_EMAIL="email@gmail.com"
