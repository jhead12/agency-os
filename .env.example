# ── agency-os environment variables ────────────────────────────────
# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real credentials.
#
#   cp .env.example .env
#
# Then load them before running:
#   source .env && python3 agency_os.py sync --campaign voter-guide--cbo-outreach-los-angeles

# ── Email sending channels ──────────────────────────────────────────

# Smartlead (cold email sequencing + warmup)
# https://app.smartlead.ai → Settings → API Keys
SMARTLEAD_API_KEY=

# OR — direct SMTP (Gmail, SendGrid, Postmark, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Contact enrichment ──────────────────────────────────────────────

# Apollo.io (contact finder — names, emails, titles at orgs)
# https://app.apollo.io → Settings → API Keys
APOLLO_API_KEY=

# Hunter.io (email finder + verifier by domain)
# https://hunter.io → API → API Key
HUNTER_API_KEY=

# ── Web dashboard / deployment ──────────────────────────────────────

# First owner account for the web dashboard. Used only when the database has
# no users yet (e.g. first Railway boot); ignored afterwards. Change the
# password from /account after signing in. Locally you can instead run:
#   python agency_os.py users create-owner --email you@example.com
AGENCY_OS_OWNER_EMAIL=
AGENCY_OS_OWNER_PASSWORD=
# AGENCY_OS_OWNER_NAME=

# Optional overrides. On Railway these default to the mounted volume
# (RAILWAY_VOLUME_MOUNT_PATH/db.sqlite and .../campaigns).
# AGENCY_OS_DB=
# AGENCY_OS_CAMPAIGNS_DIR=

BASE_URL = "https://www.u9itus.com"  # ← change this

# File: ~/projects/agency-os/campaigns/voter-guide-cbo/campaign.yaml
# Bottom of the file:
sender_name= "Joshua"        # ← change this
sender_email= "joshua@u9itus.com"  # ← change this


# Agency Access
AGENCY_OS_PASSWORD= "test"
AGENCY_OS_OWNER_EMAIL="email@gmail.com"
